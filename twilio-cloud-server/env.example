# ==============================================================
# Jarvis 24/7 Cloud Phone Calling Server Configuration
# ==============================================================

# Server HTTP & WebSocket Port
PORT=8080

# Google AI Studio Gemini API Key (MANDATORY)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_AI_STUDIO_API_KEY

# Gemini Live S2S Model & Voice Name
# Supported live models: gemini-2.0-flash-exp, gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_MODEL=gemini-2.0-flash-exp
# Deep Male voices: Puck, Charon, Fenrir | Female voices: Aoede, Kore
GEMINI_VOICE=Puck

# Twilio Credentials (Optional for local testing, required for outgoing API calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional: Webhook URL to push executed commands to your Android App or Cloud DB
ANDROID_SYNC_WEBHOOK_URL=https://your-api.com/api/jarvis-actions
